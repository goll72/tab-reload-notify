{
    "name": "tab-reload-notify",
    "version": "0.2.0",
    "description": "Automatically reload tabs with the file URI scheme using file watch primitives",
    "type": "module",
    "license": "MIT",
    "devDependencies": {
        "@biomejs/biome": "2.4.3",
        "chrome-webstore-upload-cli": "3.5.0"
    },
    "dependencies": {
        "typescript": "^5.9.3",
        "web-ext": "^9.3.0",
        "webextension-polyfill": "^0.12.0",
        "@types/firefox-webext-browser": "^143.0.0"
    },
    "webExt": {
        "sourceDir": "src",
        "ignoreFiles": [
            "*.ts",
            "*.svg"
        ],
        "build": {
            "overwriteDest": true
        }
    }
}
